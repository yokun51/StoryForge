{
	"$schema": "https://schema.tauri.app/config/2",
	"app": {
		"security": {
			"csp": null
		},
		"windows": [
			{
				"height": 600,
				"title": "Story Forge",
				"width": 800
			}
		]
	},
	"build": {
		"beforeBuildCommand": "bun run build",
		"beforeDevCommand": "bun run dev",
		"devUrl": "http://localhost:1420",
		"frontendDist": "../dist"
	},
	"bundle": {
		"active": true,
		"icon": [
			"icons/32x32.png",
			"icons/128x128.png",
			"icons/128x128@2x.png",
			"icons/icon.icns",
			"icons/icon.ico"
		],
		"license": "GNU General Public License (GPL) v3",
		"linux": {
			"appimage": {
				"bundleMediaFramework": true,
				"files": {}
			},
			"deb": {
				"files": {}
			},
			"rpm": {
				"epoch": 0,
				"files": {},
				"release": "1"
			}
		},
		"macOS": {
			"signingIdentity": "-"
		},
		"resources": ["resources/vintagestory-1.21.6.zip"],
		"targets": "all",
		"windows": {
			"certificateThumbprint": null,
			"digestAlgorithm": "sha256",
			"nsis": {
				"installerIcon": "icons/icon.ico"
			},
			"timestampUrl": ""
		}
	},
	"identifier": "StoryForge",
	"productName": "Story Forge",
	"version": "0.6.3"
}
